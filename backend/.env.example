# ---------- Nakha Wedding API (Go) ----------
# The server reads plain environment variables. For local use:
#   cp .env.example .env && set -a && source .env && set +a && go run .
# Never commit a filled-in .env. None of these values are sent to browsers.

# development | production. Production REFUSES TO START with: a default/weak
# PIN, a short APP_SECRET, COOKIE_SECURE=false, STORAGE_DRIVER=local, no
# off-server backup (BACKUP_S3_BUCKET + BACKUP_ENCRYPTION_KEY), or — inside a
# container — a DATA_DIR that is not a mounted persistent volume.
APP_ENV=development

HOST=                       # listen address; use 127.0.0.1 behind a reverse proxy
PORT=8080
DATA_DIR=./data             # MUST be persistent (host disk / Docker volume, never the container layer):
                            #   db/global.json, db/events/{event_id}.json, audit.log
                            #   (+ objects/ only with the dev-only local storage driver)
STATIC_DIR=                 # exported frontend (../out) to serve at / in production

# --- secrets ---
ADMIN_PIN=change-me-123456  # admin login; min 6 chars, use something long
ADMIN_PATH=                 # secret admin URL: <PUBLIC_BASE_URL>/<ADMIN_PATH>/ — `openssl rand -hex 12`.
                            # /admin returns 404 and every /api/admin/* call without this key
                            # returns 404 too (PIN login is unreachable). Empty = admin disabled.
APP_SECRET=                 # ≥32 random chars: `openssl rand -base64 48`. Signs QR, Live Wall links,
                            # media URLs and local upload URLs. Keep stable across restarts.

# --- browser / proxy ---
PUBLIC_BASE_URL=http://localhost:3000   # site URL used in QR codes and host/Live Wall links
ALLOWED_ORIGINS=http://localhost:3000   # comma separated; only needed when the browser calls the API cross-origin
COOKIE_SECURE=false         # true in production (HTTPS). Chrome accepts Secure cookies on http://localhost,
                            # Safari does not — keep false for local dev.
TRUST_PROXY=false           # true only when behind your own nginx/Caddy (uses the last X-Forwarded-For hop)

# --- storage (photos are always private; binaries never go into the JSON files) ---
STORAGE_DRIVER=local        # local = dev/tests only | s3 = required in production (Cloudflare R2, AWS S3, MinIO)
S3_ENDPOINT=                # R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=10            # hard capped at 10
ORPHAN_SWEEP_HOURS=6        # delete unreferenced objects (older than 1 h) at startup and every N hours

# --- backups of the JSON data (encrypted AES-256-GCM, rotating, off-server) ---
BACKUP_ENCRYPTION_KEY=      # `openssl rand -base64 32`; keep a copy OFF this server
BACKUP_S3_BUCKET=           # separate bucket recommended (enable versioning / object lock)
BACKUP_S3_ENDPOINT=         # defaults to S3_ENDPOINT
BACKUP_S3_REGION=           # defaults to S3_REGION
BACKUP_S3_ACCESS_KEY_ID=    # defaults to S3_ACCESS_KEY_ID (better: a separate key scoped to the backup bucket)
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RETENTION=28         # versions kept (6-hourly → 7 days)
BACKUP_INTERVAL_HOURS=6     # plus one at startup and one on graceful shutdown
BACKUP_DIR=                 # dev only: local backup folder (not off-server, refused as the only target in production)

# --- photobooth rules ---
EVENT_TIMEZONE=Asia/Jakarta
EVENT_WINDOW_BEFORE_MINUTES=60
EVENT_WINDOW_AFTER_MINUTES=60
MAX_GPS_ACCURACY_METERS=100
REQUIRE_LOCATION=false      # false (default) = QR token alone grants access; true = also require guests inside the venue geofence
LOCATION_RECHECK_MINUTES=10 # max 15; location is also re-checked before every upload
HOST_SESSION_HOURS=24       # max 24
