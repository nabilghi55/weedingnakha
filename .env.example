# ---------- Frontend (Next.js) ----------
# Copy to .env.local. Backend variables live in backend/.env.example.

# URL of the Go API that Next.js proxies /api/* and /host/access to (dev / `next start`)
BACKEND_URL=http://localhost:8080

# Optional: call the API directly from the browser instead of via the proxy.
# The Go server must then list this site in ALLOWED_ORIGINS, and cookies
# become cross-site — the proxy (default) is strongly recommended.
# NEXT_PUBLIC_API_URL=http://localhost:8080

# Nothing secret may ever be put in a NEXT_PUBLIC_* variable: it is shipped to browsers.
